{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "examples",
    "outDir": ".generated/examples",
    "paths": {
      "semi-ui-vue": ["../packages/semi-ui-vue/dist/index.d.ts"],
      "semi-icons-vue": ["../packages/semi-icons-vue/dist/index.d.ts"],
      "semi-icons-lab-vue": ["../packages/semi-icons-lab-vue/dist/index.d.ts"],
      "semi-illustrations-vue": [
        "../packages/semi-illustrations-vue/dist/index.d.ts"
      ],
      "semi-icons-vue/Icon": [
        "../packages/semi-icons-vue/dist/components/index.d.ts"
      ],
      "semi-ui-vue/icons": [
        "../packages/semi-ui-vue/dist/components/icons/index.d.ts"
      ],
      "semi-ui-vue/locale/source/*": [
        "../packages/semi-ui-vue/dist/locale/source/*.d.ts"
      ],
      "semi-animation-vue": ["../packages/semi-animation-vue/dist/index.d.ts"],
      "semi-animation-vue/lifecycle": [
        "../packages/semi-animation-vue/dist/lifecycle/index.d.ts"
      ],
      "semi-ui-vue/locale": [
        "../packages/semi-ui-vue/dist/components/locale/index.d.ts"
      ],
      "semi-ui-vue/locale/interface": [
        "../packages/semi-ui-vue/dist/locale/interface.d.ts"
      ],
      "semi-ui-vue/spin": [
        "../packages/semi-ui-vue/dist/components/spin/index.d.ts"
      ],
      "semi-ui-vue/iconButton": [
        "../packages/semi-ui-vue/dist/components/iconButton/index.d.ts"
      ],
      "semi-ui-vue/space": [
        "../packages/semi-ui-vue/dist/components/space/index.d.ts"
      ],
      "semi-ui-vue/grid": [
        "../packages/semi-ui-vue/dist/components/grid/index.d.ts"
      ],
      "semi-ui-vue/layout": [
        "../packages/semi-ui-vue/dist/components/layout/index.d.ts"
      ],
      "semi-ui-vue/skeleton": [
        "../packages/semi-ui-vue/dist/components/skeleton/index.d.ts"
      ],
      "semi-ui-vue/progress": [
        "../packages/semi-ui-vue/dist/components/progress/index.d.ts"
      ],
      "semi-ui-vue/tooltip": [
        "../packages/semi-ui-vue/dist/components/tooltip/index.d.ts"
      ],
      "semi-ui-vue/highlight": [
        "../packages/semi-ui-vue/dist/components/highlight/index.d.ts"
      ]
    }
  },
  "include": ["examples/**/*.tsx"],
  "exclude": []
}
