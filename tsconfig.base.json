{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "vue-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "semi-ui-vue": ["./packages/semi-ui-vue/src/index.ts"],
      "semi-icons-vue": ["./packages/semi-icons-vue/src/index.ts"],
      "semi-icons-lab-vue": ["./packages/semi-icons-lab-vue/src/index.ts"],
      "semi-illustrations-vue": [
        "./packages/semi-illustrations-vue/src/index.ts"
      ],
      "semi-animation-vue": ["./packages/semi-animation-vue/src/index.ts"],
      "vite-plugin-semi-theme": [
        "./packages/vite-plugin-semi-theme/src/index.ts"
      ],
      "semi-ui-vue/locale/source/*": [
        "./packages/semi-ui-vue/src/locale/source/*.ts"
      ],
      "semi-animation-vue/lifecycle": [
        "./packages/semi-animation-vue/src/lifecycle/index.ts"
      ],
      "semi-ui-vue/icons": [
        "./packages/semi-ui-vue/src/components/icons/index.ts"
      ],
      "semi-icons-vue/Icon": [
        "./packages/semi-icons-vue/src/components/index.ts"
      ],
      "semi-ui-vue/configProvider": [
        "./packages/semi-ui-vue/src/components/configProvider/index.ts"
      ],
      "semi-ui-vue/locale": [
        "./packages/semi-ui-vue/src/components/locale/index.ts"
      ],
      "semi-ui-vue/locale/interface": [
        "./packages/semi-ui-vue/src/locale/interface.ts"
      ],
      "semi-ui-vue/spin": [
        "./packages/semi-ui-vue/src/components/spin/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  }
}
