{
  "name": "vite-plugin-semi-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.package.config.ts && tsmc -p tsconfig.build.json && node ../../scripts/finalize-package.mjs",
    "typecheck": "tsmc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vite": "8.3.0"
  }
}
