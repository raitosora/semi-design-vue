{
  "name": "semi-ui-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "node": {
          "types": "./dist/infrastructure.d.ts",
          "default": "./dist/infrastructure.js"
        },
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles": {
      "sass": "./dist/styles/index.scss",
      "default": "./dist/styles/index.css"
    },
    "./styles/base": {
      "sass": "./dist/styles/base.scss",
      "default": "./dist/styles/base.css"
    },
    "./styles/components/input": {
      "sass": "./dist/styles/components/input.scss",
      "default": "./dist/styles/components/input.css"
    },
    "./styles/components/tooltip": {
      "sass": "./dist/styles/components/tooltip.scss",
      "default": "./dist/styles/components/tooltip.css"
    },
    "./styles/theme/tokens": {
      "sass": "./dist/styles/theme/tokens.scss",
      "default": "./dist/styles/theme/tokens.css"
    },
    "./styles/theme/mixins": {
      "sass": "./dist/styles/theme/mixins.scss",
      "default": "./dist/styles/theme/mixins.css"
    },
    "./styles.css": "./dist/styles/index.css",
    "./styles.scss": "./dist/styles/index.scss",
    "./styles/index.css": "./dist/styles/index.css",
    "./styles/index.scss": "./dist/styles/index.scss",
    "./styles/base.css": "./dist/styles/base.css",
    "./styles/base.scss": "./dist/styles/base.scss",
    "./styles/components/input.css": "./dist/styles/components/input.css",
    "./styles/components/input.scss": "./dist/styles/components/input.scss",
    "./styles/components/tooltip.css": "./dist/styles/components/tooltip.css",
    "./styles/components/tooltip.scss": "./dist/styles/components/tooltip.scss",
    "./styles/theme/tokens.css": "./dist/styles/theme/tokens.css",
    "./styles/theme/tokens.scss": "./dist/styles/theme/tokens.scss",
    "./styles/theme/mixins.css": "./dist/styles/theme/mixins.css",
    "./styles/theme/mixins.scss": "./dist/styles/theme/mixins.scss",
    "./locale/source/*": {
      "types": "./dist/locale/source/*.d.ts",
      "import": "./dist/locale/source/*.js"
    },
    "./locale/interface": {
      "types": "./dist/locale/interface.d.ts",
      "import": "./dist/locale/interface.js"
    },
    "./icons": {
      "types": "./dist/components/icons/index.d.ts",
      "import": "./dist/components/icons/index.js"
    },
    "./styles/components/icons": {
      "sass": "./dist/styles/components/icons.scss",
      "default": "./dist/styles/components/icons.css"
    },
    "./styles/components/icons.css": "./dist/styles/components/icons.css",
    "./styles/components/icons.scss": "./dist/styles/components/icons.scss",
    "./configProvider": {
      "types": "./dist/components/configProvider/index.d.ts",
      "import": "./dist/components/configProvider/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "style": "./dist/styles/index.css",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.package.config.ts && tsmc -p tsconfig.build.json && node ../../scripts/build-styles.mjs && node ../../scripts/build-locale.mjs && node ../../scripts/finalize-package.mjs",
    "typecheck": "tsmc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "3.6.0-rc.9"
  },
  "dependencies": {
    "date-fns": "2.30.0",
    "semi-animation-vue": "workspace:*",
    "semi-icons-vue": "workspace:*"
  }
}
