{
  "name": "semi-design-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": "10.33.0"
  },
  "devDependencies": {
    "@douyinfe/semi-foundation": "2.103.0",
    "@douyinfe/semi-theme-default": "2.103.0",
    "@playwright/test": "1.63.0",
    "@ts-macro/tsc": "0.3.7",
    "@types/node": "24.12.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vue-jsx/eslint": "3.3.0-rc.2",
    "@vue-jsx/runtime": "3.3.0-rc.2",
    "@vue/server-renderer": "3.6.0-rc.9",
    "@vue/shared": "3.6.0-rc.9",
    "eslint": "9.39.4",
    "monocart-coverage-reports": "2.12.6",
    "prettier": "3.8.3",
    "sass": "1.97.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.1",
    "vue": "3.6.0-rc.9",
    "vue-jsx": "3.3.0-rc.2",
    "date-fns": "2.30.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsmc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm build:packages && pnpm build:playground",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:playground": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:test-harness": "vite build --config vite.test.config.ts",
    "check:types": "node scripts/check-types.mjs",
    "check:consumer": "node scripts/check-consumer.mjs && pnpm check:style-consumer && pnpm check:resource-consumer && pnpm check:foundation-consumer",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "verify": "pnpm check && pnpm format:check && pnpm check:dependencies && pnpm check:upstream && pnpm check:foundation-patch && pnpm check:types && pnpm check:surfaces && pnpm test:coverage && pnpm build && pnpm check:consumer && pnpm build:test-harness && pnpm test:e2e",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:dev": "pnpm docs:build && pnpm exec vitepress dev website",
    "docs:build": "node website/build.mjs",
    "docs:preview": "pnpm exec vitepress preview website",
    "check:style-consumer": "node scripts/check-style-consumer.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "check:resource-consumer": "node scripts/check-resource-consumer.mjs",
    "generate:resources": "node scripts/generate-resources.mjs && node scripts/locale-inputs.mjs && node scripts/resource-index.mjs",
    "check:resource-index": "node scripts/resource-index.mjs --check",
    "check:foundation-consumer": "node scripts/check-foundation-consumer.mjs",
    "check:packages": "pnpm build:packages && pnpm check:consumer",
    "refresh:upstream": "node scripts/upstream-refresh.mjs",
    "generate:upstream": "node scripts/check-upstream.mjs --write",
    "check:upstream": "node scripts/check-upstream.mjs --check",
    "check:foundation-patch": "node scripts/check-foundation-patch.mjs",
    "check:component-changes": "node scripts/component-change-gate.mjs"
  },
  "license": "MIT"
}
