{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "*.ts",
    "config/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "playground/src/**/*.ts",
    "playground/src/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "artifacts"]
}
